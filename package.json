{
  "name": "cuenta-cobro",
  "version": "1.0.8",
  "description": "Aplicación de escritorio para la gestión de cuentas de cobro generada con Electron, Vue 3 y Vite.",
  "author": "necro304",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/necro304/cuenta_de_cobro_escritorio.git"
  },
  "bugs": {
    "url": "https://github.com/necro304/cuenta_de_cobro_escritorio/issues"
  },
  "homepage": "https://github.com/necro304/cuenta_de_cobro_escritorio#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "test:database": "vite build --config electron/vite.cuentaDeCobro-test.config.ts && electron --no-sandbox dist-ssr/cuentaDeCobro.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@lucide/vue": "^1.17.0",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "globals": "^17.6.0",
    "reka-ui": "^2.9.9",
    "signature_pad": "^5.1.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.0",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "main": "dist-electron/main.js"

{
  "name": "cuenta-cobro",
  "private": true,
  "version": "2.0.0",
  "description": "Aplicación de escritorio para la gestión de cuentas de cobro colombianas, construida con Tauri 2, Vue 3 y Vite.",
  "author": "necro304",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/necro304/cuenta_de_cobro_escritorio.git"
  },
  "bugs": {
    "url": "https://github.com/necro304/cuenta_de_cobro_escritorio/issues"
  },
  "homepage": "https://github.com/necro304/cuenta_de_cobro_escritorio#readme",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:unsigned": "tauri build --config src-tauri/tauri.unsigned.conf.json",
    "build:web": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:renderer": "vitest run",
    "test:watch": "vitest",
    "test:database": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@lucide/vue": "^1.72.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify@2.0.3": {
      "editorconfig": "^4.0.1",
      "glob": "^14.0.6"
    }
  }
}
